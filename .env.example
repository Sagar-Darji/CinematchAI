# LLM Configuration
# Primary provider: 'groq' (fast cloud, recommended) or 'ollama' (local)
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_MAIN=llama3.1:70b
OLLAMA_MODEL_FAST=llama3.1:8b

# Groq API (Primary cloud LLM — free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_MAIN=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# TMDB API
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_RATE_LIMIT=40  # requests per 10 seconds

# Vector Database (Local)
CHROMA_PERSIST_DIR=./data/vectordb
CHROMA_COLLECTION_MOVIES=cinematch_movies
CHROMA_COLLECTION_USERS=cinematch_users

# Zilliz Cloud (primary - free tier: https://cloud.zilliz.com)
ZILLIZ_URI=https://xxx.zillizcloud.com
ZILLIZ_TOKEN=your_zilliz_token_here

# Qdrant Cloud (backup - free tier: https://cloud.qdrant.io)
QDRANT_URL=https://xxx.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Cloud Vector DB
CLOUD_VECTORDB_COLLECTION=cinematch_movies

# Application Settings
APP_NAME=CineMatch AI
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Streamlit Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Recommendation Settings
DEFAULT_NUM_RECOMMENDATIONS=10
MAX_RECOMMENDATIONS=50
EXPLORATION_RATE=0.3

# Cache Settings
CACHE_DIR=./cache
CACHE_TTL_HOURS=1
PROFILE_CACHE_TTL_MINUTES=60
RECOMMENDATION_CACHE_TTL_MINUTES=15

# Database
DATABASE_URL=sqlite:///./data/cinematch.db

# Embedding Settings
TEXT_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32
HYBRID_TEXT_WEIGHT=0.7
HYBRID_IMAGE_WEIGHT=0.3
# Set to true to blend CLIP poster embeddings into user profiles (requires ~600 MB CLIP download)
USE_MULTIMODAL_EMBEDDINGS=false

# Deployment
DEPLOYMENT_ENV=development  # development, staging, production
HF_SPACE=false

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret   # run: openssl rand -hex 32
GOOGLE_CLIENT_ID=                           # Google OAuth Client ID (optional — enables Google Sign-In)
APP_URL=http://localhost:3000               # Public URL — used in password-reset email links

# ── Email / SMTP (for password-reset emails) ──────────────────────────────────
# Leave blank to use dev-mode: reset links are printed to API logs instead.
SMTP_HOST=                                  # e.g. smtp.gmail.com
SMTP_PORT=587                               # 587=STARTTLS  465=SSL
SMTP_USER=                                  # your SMTP login
SMTP_PASSWORD=                              # your SMTP password / Gmail App Password
SMTP_FROM=                                  # e.g. CineMatch AI <you@gmail.com>

# ── Supabase (for persistent users on HF Spaces) ─────────────────────────────
# Leave blank locally — app uses SQLite. Set to postgres:// URI on HF Spaces.
# USERS_DB_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
