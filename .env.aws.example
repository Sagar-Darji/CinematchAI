# ─────────────────────────────────────────────────────────────────────────────
# CinematchAI — AWS Deployment Environment Variables
# Copy to .env and fill in your values before deploying.
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployment flags ──────────────────────────────────────────────────────────
DEPLOYMENT_ENV=production
LAMBDA_DEPLOYMENT=true

# ── LLM — Groq (free tier) ───────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_MAIN=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# ── Embeddings — Voyage AI (voyage-3, 1024-dim) ──────────────────────────────
EMBEDDING_PROVIDER=voyage
EMBEDDING_DIM=1024
VOYAGE_API_KEY=your_voyage_ai_api_key_here

# ── Vector DB — Qdrant Cloud (free tier, 1GB forever) ────────────────────────
# Get from: https://cloud.qdrant.io → Create Cluster → API Key
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
CLOUD_VECTORDB_COLLECTION=cinematch_movies

# ── Auth & User DB — Supabase PostgreSQL (free tier, 500MB forever) ──────────
# Get from: https://supabase.com → Project Settings → Database → Connection string
AUTH_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── App URL (your API Gateway URL) ───────────────────────────────────────────
# Set after creating API Gateway: https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
APP_URL=https://your-amplify-app.amplifyapp.com

# ── TMDB (optional, for poster enrichment) ───────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here

# ── Temp storage on Lambda (/tmp is writable, max 512MB–10GB configurable) ───
CACHE_DIR=/tmp/cache
DATA_DIR=/tmp/data

# ── Disable HF-specific features ─────────────────────────────────────────────
HF_SPACE=false
