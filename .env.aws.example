# ─────────────────────────────────────────────────────────────────────────────
# CinematchAI — AWS Deployment Environment Variables
# Copy to .env (or set as Lambda env vars) and fill in your real values.
# DO NOT commit a real .env / .env.aws — these names are in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployment flags ──────────────────────────────────────────────────────────
DEPLOYMENT_ENV=production
LAMBDA_DEPLOYMENT=true

# ── LLM — Groq (free tier) ───────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_MAIN=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# ── Embeddings — Voyage AI (voyage-3, 1024-dim) ──────────────────────────────
# Get from: https://www.voyageai.com → Dashboard → API Keys
EMBEDDING_PROVIDER=voyage
EMBEDDING_DIM=1024
VOYAGE_API_KEY=your_voyage_api_key_here

# ── Vector DB — Qdrant Cloud (free tier, 1GB forever) ────────────────────────
# Get from: https://cloud.qdrant.io → Create Cluster → API Key
QDRANT_URL=https://your-cluster-id.your-region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
CLOUD_VECTORDB_COLLECTION=cinematch_movies

# ── Auth & User DB — Supabase PostgreSQL (free tier, 500MB forever) ──────────
# Get from: https://supabase.com → Project Settings → Database → Connection string
# Use the *Pooler* URL (port 6543) when DEPLOYMENT_ENV=production for Lambda.
AUTH_DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=generate_with_openssl_rand_hex_32
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# ── App URL (your Amplify domain or custom domain) ──────────────────────────
APP_URL=https://your-amplify-app.amplifyapp.com

# ── TMDB (optional, for poster enrichment) ───────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here

# ── Temp storage on Lambda (/tmp is writable, max 512MB–10GB configurable) ───
CACHE_DIR=/tmp/cache
DATA_DIR=/tmp/data

# ── Disable HF-specific features ─────────────────────────────────────────────
HF_SPACE=false
