# ─────────────────────────────────────────────────────────────────────────────
# CinematchAI — Lambda Container Image
# Base: AWS Lambda Python 3.11 (arm64 for cost efficiency on Graviton)
# No torch / sentence-transformers — embeddings via Voyage AI API.
# ─────────────────────────────────────────────────────────────────────────────
FROM public.ecr.aws/lambda/python:3.11-arm64

WORKDIR ${LAMBDA_TASK_ROOT}

# psycopg2 may fall back to a source build on arm64; provide pg_config/toolchain.
RUN yum install -y gcc postgresql-devel && yum clean all

# Install Python deps (slimmed — no torch/transformers)
# All packages use binary wheels — no system lib compilation needed
COPY requirements-aws.txt .
RUN pip install --no-cache-dir -r requirements-aws.txt

# Copy application code
COPY config/       ./config/
COPY src/          ./src/
COPY lambda_handler.py .

# Ensure data dir exists (Lambda writes to /tmp only; bind mounts not available)
RUN mkdir -p /tmp/data /tmp/cache

ENV PYTHONPATH="${LAMBDA_TASK_ROOT}" \
    LAMBDA_DEPLOYMENT="true" \
    CACHE_DIR="/tmp/cache" \
    DATA_DIR="/tmp/data"

CMD ["lambda_handler.handler"]
